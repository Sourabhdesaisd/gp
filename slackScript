# ==============================================================
# Script : slack_script.tcl
# Purpose: Extract all violating timing paths from Genus report
# ==============================================================
 
# --------------------------------------------------------------
# User settings
# --------------------------------------------------------------
 
# Maximum number of timing paths to report
set max_paths 1600
 
# Timing report generated by Genus
set rpt_file "timing_maxpath1000.rpt"
 
# Output files
set violation_report "violating_paths.rpt"
set csv_file         "violating_paths.csv"
 
 
# --------------------------------------------------------------
# Generate timing report
# --------------------------------------------------------------
 
puts "=============================================================="
puts "Generating timing report..."
puts "Maximum paths : $max_paths"
puts "Report file   : $rpt_file"
puts "=============================================================="
 
report_timing -max_paths $max_paths > $rpt_file
 
 
# --------------------------------------------------------------
# Open timing report
# --------------------------------------------------------------
 
if {![file exists $rpt_file]} {
    puts "ERROR: Timing report '$rpt_file' does not exist."
    return
}
 
set fp [open $rpt_file r]
set report [read $fp]
close $fp
 
set lines [split $report "\n"]
 
 
# --------------------------------------------------------------
# Open output files
# --------------------------------------------------------------
 
set out [open $violation_report w]
set csv [open $csv_file w]
 
 
# CSV header
puts $csv "Path,Startpoint,Endpoint,Slack_ps,Slack_ns"
 
 
# --------------------------------------------------------------
# Header
# --------------------------------------------------------------
 
puts $out "=============================================================="
puts $out "             TIMING VIOLATION REPORT"
puts $out "=============================================================="
puts $out ""
puts $out "Source report : $rpt_file"
puts $out "Maximum paths : $max_paths"
puts $out ""
 
puts $out "Path    Startpoint    Endpoint    Slack"
puts $out "--------------------------------------------------------------"
 
 
# --------------------------------------------------------------
# Variables
# --------------------------------------------------------------
 
set path_number ""
set startpoint ""
set endpoint ""
set slack_ps ""
set slack_ns ""
 
set count 0
 
 
# --------------------------------------------------------------
# Parse timing report
# --------------------------------------------------------------
 
foreach line $lines {
 
    # ----------------------------------------------------------
    # Detect beginning of a new path
    #
    # Example:
    #
    # Path 51: VIOLATED (-1038 ps)
    # ----------------------------------------------------------
 
    if {[regexp {^Path\s+([0-9]+):\s+VIOLATED\s+\((-?[0-9]+)\s+ps\)} \
        $line -> new_path new_slack]} {
 
        # If previous path exists, process it first
        if {$path_number ne "" && $slack_ps ne ""} {
 
            if {$slack_ps < 0} {
 
                incr count
 
                set slack_ns [format "%.3f" [expr {$slack_ps / 1000.0}]]
 
                puts $out "--------------------------------------------------------------"
                puts $out "Path       : $path_number"
                puts $out "Startpoint : $startpoint"
                puts $out "Endpoint   : $endpoint"
                puts $out "Slack      : $slack_ps ps"
                puts $out "Slack      : $slack_ns ns"
                puts $out ""
 
                puts $csv "$path_number,\"$startpoint\",\"$endpoint\",$slack_ps,$slack_ns"
            }
        }
 
        # Reset for new path
        set path_number $new_path
        set startpoint ""
        set endpoint ""
        set slack_ps $new_slack
        set slack_ns ""
 
        continue
    }
 
 
    # ----------------------------------------------------------
    # Extract Startpoint
    # ----------------------------------------------------------
 
    if {[regexp {^\s*Startpoint:\s*(?:\(R\)|\(F\))?\s*(\S+)} \
        $line -> sp]} {
 
        set startpoint $sp
        continue
    }
 
 
    # ----------------------------------------------------------
    # Extract Endpoint
    # ----------------------------------------------------------
 
    if {[regexp {^\s*Endpoint:\s*(?:\(R\)|\(F\))?\s*(\S+)} \
        $line -> ep]} {
 
        set endpoint $ep
        continue
    }
 
 
    # ----------------------------------------------------------
    # Extract Slack
    # ----------------------------------------------------------
 
    if {[regexp {^\s*Slack\s*:=\s*(-?[0-9]+(?:\.[0-9]+)?)\s*$} \
        $line -> slk]} {
 
        set slack_ps $slk
        continue
    }
}
 
 
# --------------------------------------------------------------
# Process final path
# --------------------------------------------------------------
 
if {$path_number ne "" && $slack_ps ne ""} {
 
    if {$slack_ps < 0} {
 
        incr count
 
        set slack_ns [format "%.3f" [expr {$slack_ps / 1000.0}]]
 
        puts $out "--------------------------------------------------------------"
        puts $out "Path       : $path_number"
        puts $out "Startpoint : $startpoint"
        puts $out "Endpoint   : $endpoint"
        puts $out "Slack      : $slack_ps ps"
        puts $out "Slack      : $slack_ns ns"
        puts $out ""
 
        puts $csv "$path_number,\"$startpoint\",\"$endpoint\",$slack_ps,$slack_ns"
    }
}
 
 
# --------------------------------------------------------------
# Summary
# --------------------------------------------------------------
 
puts $out "=============================================================="
puts $out "SUMMARY"
puts $out "=============================================================="
puts $out "Total violating paths : $count"
puts $out "Maximum paths checked : $max_paths"
puts $out ""
puts $out "A path is considered violating when:"
puts $out "Slack < 0 ps"
puts $out ""
puts $out "=============================================================="
 
 
# --------------------------------------------------------------
# Close output files
# --------------------------------------------------------------
 
close $out
close $csv
 
 
# --------------------------------------------------------------
# Print result to Genus terminal
# --------------------------------------------------------------
 
puts ""
puts "=============================================================="
puts "TIMING ANALYSIS COMPLETE"
puts "=============================================================="
puts "Timing report       : $rpt_file"
puts "Violating paths     : $count"
puts "Detailed report     : $violation_report"
puts "CSV report          : $csv_file"
puts "=============================================================="
puts ""
 
if {$count == 0} {
    puts "WARNING: No negative-slack paths were detected."
} else {
    puts "Found $count violating paths."
}
 
puts ""
