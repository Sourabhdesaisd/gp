set sdc_version 2.0

set_units -capacitance 1000.0fF
set_units -time 1000.0ps

# Set the current design
current_design pinaka

create_clock -name "TCK" -period 500.0 -waveform {0.0 250.0} [get_ports TCK]
create_clock -name "pll_clk" -period 2.5 -waveform {0.0 1.25} [get_ports pll_clk]
create_clock -name "xtal_clk" -period 40.0 -waveform {0.0 20.0} [get_ports xtal_clk]
create_clock -name "rc_clk" -period 20000.0 -waveform {0.0 10000.0} [get_ports rc_clk]
create_generated_clock -name "core_clk" -divide_by 1     -source [get_ports pll_clk]   [get_pins clk_rst_ctrl_top_instance/clk_soc_o] 
create_generated_clock -name "debug_clk" -divide_by 2     -source [get_pins clk_rst_ctrl_top_instance/clk_soc_o]   [get_pins clk_rst_bypass_top_instance/clk_for_jtag] 
create_generated_clock -name "pclk" -divide_by 2     -source [get_pins clk_rst_ctrl_top_instance/clk_soc_o]   [get_pins clk_rst_ctrl_top_instance/clk_per_o] 
create_generated_clock -name "memory_clk" -divide_by 1     -source [get_pins clk_rst_ctrl_top_instance/clk_soc_o]   [get_pins clk_rst_bypass_top_instance/clk_for_mem_out] 
create_generated_clock -name "ctrl_bypass_debug_clk" -divide_by 2     -source [get_pins clk_rst_ctrl_top_instance/clk_soc_o]   [get_pins clk_rst_ctrl_top_instance/clk_for_debug_o] 
create_generated_clock -name "bclk" -divide_by 27     -source [get_pins clk_rst_ctrl_top_instance/clk_per_o]   [get_pins uart_wrapper_instance_dut/bclk_reg/Q] 
create_generated_clock -name "rx_baud_clk" -divide_by 1     -source [get_pins uart_wrapper_instance_dut/bclk_reg/Q]   [get_pins uart_wrapper_instance_dut/rx_baud_clk_reg/Q] 
